# Example environment file. Copy to .env and fill in your API key.
OPENAI_API_KEY=your-openai-api-key-here

# Same convention as interview-poc-sharepoint/interview-poc-rust: HS256,
# must be at least 32 bytes (RFC 7518 §3.2). Use the SAME value as those
# services' JWT_SECRET to decode their real tokens here too.
JWT_SECRET=CHANGE-ME-LOCAL-DEV-JWT-SECRET-32BYTES-MIN
